API_PORT=8000
APP_NAME=R_CHAT
JWT_SECRET_KEY=replace-with-a-long-random-secret
HASH_ROUND=12

# These defaults match docker-compose.yml.
REDIS_URL=redis://default:local-redis-password@localhost:6378
DATABASE_NAME=webrtc
DB_CONNECTION_STRING=mongodb://mongo:local-mongo-password@localhost:27017/webrtc?authSource=admin

RTC_MIN_PORT=10000
RTC_MAX_PORT=10100
MEDIASOUP_LISTEN_IP=127.0.0.1
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
NUM_WORKER=2
